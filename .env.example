# ==============================================
# AIrStreamX Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ==============================================

# Backend API URL (without trailing slash)
# Used by Vite for client-side requests
VITE_API_BASE=http://localhost:5000

# Backend API URL for server-side code (api/ handlers)
API_BASE=http://localhost:5000

# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=import.meta.env.VITE_FIREBASE_API_KEY || "AIzaSyCzVSP_hSQV3px36LwrcIrdKskbYCbkXo8",
VITE_FIREBASE_AUTH_DOMAIN=import.meta.env.VITE_FIREBASE_AUTH_DOMAIN || "streamlite-6814b.firebaseapp.com",
VITE_FIREBASE_PROJECT_ID=import.meta.env.VITE_FIREBASE_PROJECT_ID || "streamlite-6814b",
VITE_FIREBASE_STORAGE_BUCKET=import.meta.env.VITE_FIREBASE_STORAGE_BUCKET || "streamlite-6814b.firebasestorage.app",
VITE_FIREBASE_MESSAGING_SENDER=import.meta.env.VITE_FIREBASE_MESSAGING_SENDER || "64626871662",
